{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/backend-mark.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/frontend-mark.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/backend-tests.sh\"",
            "asyncRewake": true,
            "rewakeMessage": "I test del backend sono falliti dopo le tue modifiche:",
            "rewakeSummary": "Backend test falliti",
            "timeout": 600,
            "statusMessage": "Eseguo i test del backend..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/frontend-checks.sh\"",
            "asyncRewake": true,
            "rewakeMessage": "I controlli del frontend (lint/test/build) sono falliti dopo le tue modifiche:",
            "rewakeSummary": "Frontend checks falliti",
            "timeout": 600,
            "statusMessage": "Eseguo i controlli del frontend (lint, test, build)..."
          }
        ]
      }
    ]
  }
}
